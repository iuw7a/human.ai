# Copy to .env.local and fill in real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_ID=moonshotai/kimi-k3

# MCP credential encryption (server-only): 32 bytes as 64 hex chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the real value. Rotating it invalidates stored MCP credentials.
ENCRYPTION_SECRET=

# Website builder (server-only).
E2B_API_KEY=
GROQ_API_KEY=
XKIRO_API_KEY=
# Vercel API (server-only): auto-registers published subdomains on Publish.
VERCEL_API_TOKEN=
# Optional custom preview domain for E2B sandboxes (needs the Caddy proxy
# from the E2B custom-domain docs + wildcard DNS). Example:
# VCODE_PREVIEW_DOMAIN=preview.usehuman.de
# → previews become https://3000-<sandboxId>.preview.usehuman.de
VCODE_PREVIEW_DOMAIN=

# Stripe (server-only — do NOT prefix with NEXT_PUBLIC_ / VITE_).
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret (only needed once you add the fulfillment webhook):
# https://dashboard.stripe.com/workbench/webhooks
STRIPE_WEBHOOK_SECRET=
# Base URL of the app; used to build Checkout success/cancel URLs.
DOMAIN=http://localhost:3000
# Stripe Price IDs for the purchasable humi plans (Dashboard → Products → Prices).
# Must match the plans the webhook grants, so keep these in sync with the code.
STRIPE_PRICE_HUMI_ELITE=
STRIPE_PRICE_HUMI_PRO=
STRIPE_PRICE_HUMI_EXTRA=
STRIPE_PRICE_HUMI_ENTERPRISES=
